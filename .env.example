# Google OAuth client (Desktop app) from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Created by `npm run auth`
GOOGLE_REFRESH_TOKEN=

# Alternative: short-lived access token (expires in ~1 hour)
# GOOGLE_ACCESS_TOKEN=

# Alternative: service account
# GOOGLE_SERVICE_ACCOUNT_JSON=/absolute/path/to/service-account.json
# GOOGLE_IMPERSONATE_USER=you@yourdomain.com

# Alternative: Application Default Credentials
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json
